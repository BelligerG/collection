#:set deskSize 75
#:set deskBorder 4
#:set innerDeskSize deskSize-deskBorder

<CustomButton>:
	size_hint_y: None
	height: "60dp"

<SaveBox>:

	canvas:
		Color:
			rgb: [0.1, 0.1, 0.1, 1]
		Rectangle:
			pos: 0, 0
			size: root.width, root.height
	GridLayout:
		cols: 2
		rows: 1
		padding: "10dp"
		spacing: "5dp"

		TextInput:
			id: FileName
			hint_text: "Filename"
			size_hint_y: None
			height: 30
			size_hint_x: None
			width: 500
			multiline: False
		BoxLayout:
			orientation: "horizontal"
			CustomButton:
				text: "Save"
				on_press: root.saveFile(FileName.text)
			CustomButton:
				text: "Back"
				on_press: root.goBack()

<SaveClassroomLayoutScreen>:

	canvas:
		Color:
			rgb: [0.1, 0.1, 0.1, 1]
		Rectangle:
			pos: 0, 0
			size: root.width, root.height
	GridLayout:
		cols: 2
